# nsec1... または hex 形式の秘密鍵。サイト公開専用の鍵を新しく作って使うことを推奨する。
# 空のままでもコンテナは起動する（ダッシュボードだけが動くセットアップモードになり、ブラウザのセットアップ画面から鍵を生成・保存できる。docs/architecture/up.md 参照）
SWING_NOSTR_SECRET_KEY=

# [nostr]
# 接続する Nostr relay（カンマ区切り）
#SWING_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://yabu.me,wss://relay-jp.nostr.wirednet.jp
# Follow Set（kind 30000）の d タグ
#SWING_MIRROR_SET=swing
# サイトイベントの kind
#SWING_SITE_EVENT_KIND=35980
# レプリカ報告イベントの kind
#SWING_REPLICA_EVENT_KIND=35981

# [ipfs]
# Kubo RPC のエンドポイント。[kubo].managed = false のときだけ使う。managed = true で指定するとエラーになる（compose の mirror コンテナでは compose.yaml が固定で渡すため、ここに書いても効果が無い）
#SWING_IPFS_API=http://127.0.0.1:5001
# SWING が使う MFS のディレクトリ
#SWING_MFS_ROOT=/swing

# [policy]
# 保存する全サイト合計の容量上限
#SWING_MAX_TOTAL_STORAGE=100GiB
# 1 サイトあたりの容量上限。超えた分は古い版から削除される。新版だけで超える更新は保存されない
#SWING_MAX_PER_SITE=10GiB
# 1 アカウントが持つ全サイトの合計容量上限。超える更新は保存されない
#SWING_MAX_PER_ACCOUNT=20GiB
# 1 アカウントあたりに保存するサイト数の上限。既に保存しているサイトの更新は続く
#SWING_MAX_SITES_PER_ACCOUNT=10
# 1 回の更新（1 バージョン）あたりのサイズ上限。超えると保存されない
#SWING_MAX_UPDATE_SIZE=2GiB
# サイトごとに保持する旧バージョンの数。超えた分は古い順に削除される
#SWING_KEEP_VERSIONS=5
# バージョンを保持する日数。最新版を除き、これより古い版は削除される
#SWING_KEEP_DAYS=365
# 同じサイトを取り込む最短間隔
#SWING_MIN_UPDATE_INTERVAL=1h
# ミラー対象から外したときに、自動でそのサイトの保存をやめるかどうか
#SWING_REMOVE_ON_UNFOLLOW=true
# 保存前に行う NIP-05 検証のモード（off / warn / require）
#SWING_NIP05=warn
# NIP-05 の検証結果を再利用する期間
#SWING_NIP05_CACHE_TTL=1d

# [agent]
# 状態ファイルを置くディレクトリ（compose の mirror コンテナでは compose.yaml が固定で渡すため、ここに書いても効果が無い）
#SWING_STATE_DIR=./data
# Follow Set の再取得間隔
#SWING_POLL_INTERVAL=5m
# 1 サイト分の取得全体のタイムアウト
#SWING_FETCH_TIMEOUT=15m
# 取得中にデータが届かないまま待つ上限
#SWING_FETCH_IDLE_TIMEOUT=2m
# 同時に取得・保存するサイト数
#SWING_CONCURRENCY=4
# レプリカ報告の有効期間。半分の期間を過ぎたら新しい報告を出す。poll_interval の 2 倍より長く、7d 以下にする必要がある（受信側はそれより古い報告を数えない）
#SWING_REPORT_TTL=3d

# [publish]
# swing publish の NIP-05 検証モード（off / warn / require、--nip05 が優先）
#SWING_PUBLISH_NIP05=warn
# swing publish が自分のノードに残す版の数
#SWING_PUBLISH_KEEP_VERSIONS=5

# [dashboard]
# ダッシュボードの待ち受けアドレス（swing up が動いている間ずっと待ち受ける）
#SWING_DASHBOARD_LISTEN=127.0.0.1:8082
# false で静的な Web UI を配信せず、/api/* の制御 API だけ残す
#SWING_DASHBOARD_UI=true
# Host ヘッダで追加で許可するホスト名（ポート抜き、カンマ区切り）
#SWING_DASHBOARD_ALLOWED_HOSTS=
# ブラウザからダッシュボードを開く URL（swing dashboard open が出すログインリンクの頭に使う）。未設定なら待ち受けアドレス
#SWING_DASHBOARD_PUBLIC_URL=http://127.0.0.1:8082
# 保存済みサイトを開くリンクの IPFS Gateway。空文字にするとリンクを表示しない
#SWING_DASHBOARD_GATEWAY=http://localhost:8080
# ダッシュボードに読み込ませる追加 CSS ファイルのパス
#SWING_DASHBOARD_CUSTOM_CSS=/path/to/custom.css
# Desktop 画面のリンク集ページ（HTML）のパス。未設定なら同梱のページ
#SWING_DASHBOARD_DESKTOP_PAGE=/path/to/links.html
# そのリンク集ページ専用の CSS ファイルのパス。未設定なら同梱の CSS
#SWING_DASHBOARD_DESKTOP_PAGE_CSS=/path/to/links.css
# リンク集ページの 88×31 バナー画像のパス（png/gif/jpeg/webp/svg）。未設定なら同梱の GIF
#SWING_DASHBOARD_DESKTOP_BANNER=/path/to/banner.gif
# POST /api/publish/upload のボディ上限。0 はエラー
#SWING_DASHBOARD_MAX_UPLOAD=2GiB

# [kubo]
# true なら swing up が Kubo を子プロセスとして動かす。false なら外部の Kubo（[ipfs].api）を使う（compose の mirror コンテナでは compose.yaml が固定で渡すため、ここに書いても効果が無い）
#SWING_KUBO_MANAGED=true
# 管理する Kubo の実行ファイルのパス。既定: swing 実行ファイルと同じディレクトリの ipfs(.exe)、無ければ PATH の ipfs
#SWING_KUBO_BINARY=/usr/local/bin/ipfs
# 管理する Kubo のリポジトリ（IPFS_PATH）。既定: [agent].state_dir/kubo
#SWING_KUBO_REPO=./data/kubo
# Kubo の Datastore.StorageMax。既定: [policy].max_total_storage と同じ値。GiB 系で書くと compose の Kubo でも同じ値になる（Kubo は GB を 10 進で解釈する）
#SWING_KUBO_STORAGE_MAX=100GiB
# Kubo の Provide.Strategy
#SWING_KUBO_PROVIDE_STRATEGY=pinned+mfs
# 管理する Kubo の Addresses.Gateway
#SWING_KUBO_GATEWAY_LISTEN=127.0.0.1:8080
# 管理する Kubo の swarm ポート。未設定なら Kubo の既定のまま触らない
#SWING_KUBO_SWARM_PORT=4001

# [gateway]
# SWING 内蔵 DNSLink ゲートウェイの待ち受けアドレス（例 "127.0.0.1:8081"）。"off" で無効
#SWING_GATEWAY_LISTEN=off
# DNSLink で配信するホスト名（カンマ区切り）。listen が off でないなら必須。managed なら Kubo の Gateway.PublicGateways にも入れる
#SWING_GATEWAY_HOSTS=
# プロキシ先の Kubo gateway。既定: managed なら http://<[kubo].gateway_listen>、そうでなければ http://127.0.0.1:8080（compose の mirror コンテナでは compose.yaml が固定で渡すため、ここに書いても効果が無い）
#SWING_GATEWAY_UPSTREAM=http://127.0.0.1:8080

# --- Docker Compose 専用のホストバインド（上の SWING_* とは別物。config::env_var は読まない） ---
# Kubo のゲートウェイをホストのどこに公開するか（ipfs コンテナ）
#SWING_KUBO_GATEWAY_BIND=127.0.0.1:8080
# swing 内蔵ゲートウェイをホストのどこに公開するか（mirror コンテナ）
#SWING_GATEWAY_BIND=127.0.0.1:8081
# ダッシュボードをホストのどこに公開するか（mirror コンテナ）
#SWING_DASHBOARD_BIND=127.0.0.1:8082
