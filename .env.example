# nsec1... または hex 形式の秘密鍵。サイト公開専用の鍵を新しく作って使うことを推奨する
SWING_NOSTR_SECRET_KEY=

SWING_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://yabu.me,wss://relay-jp.nostr.wirednet.jp
SWING_MIRROR_SET=swing
SWING_MAX_TOTAL_STORAGE=20GB
# Kubo の Datastore.StorageMax。未設定なら SWING_MAX_TOTAL_STORAGE と同じ値
#SWING_KUBO_STORAGE_MAX=25GB
# Kubo の Provide.Strategy。SWING は MFS に置くので mfs を含める
#SWING_KUBO_PROVIDE_STRATEGY=pinned+mfs
# Kubo の Gateway（NoFetch）をホストのどこに出すか
#SWING_KUBO_GATEWAY_BIND=127.0.0.1:8080
# gateway プロファイルで DNSLink を配信するホスト名（カンマ区切り）
#SWING_GATEWAY_HOSTS=example.com,blog.example.net
# gateway プロファイルの Caddy（HTTP）をホストのどこに出すか
#SWING_GATEWAY_BIND=127.0.0.1:8081
